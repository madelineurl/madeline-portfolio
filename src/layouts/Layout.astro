---
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import Logo from "../assets/images/MADELINE_LOGO_WHITE.png";
import "../styles/layout.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png?v=20261027"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261027" />
    <link rel="shortcut icon" href="/favicon.ico?v=20261027" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=20261027"
    />
    <meta name="apple-mobile-web-app-title" content="Madeline" />
    <link rel="manifest" href="/site.webmanifest?v=20261027" />
    <meta name="generator" content={Astro.generator} />
    <title>Madeline | Music Artist</title>
    <!-- TODO: SEO -->
  </head>
  <body>
    <header>
      <a href="/">
        <img src={Logo.src} />
      </a>
    </header>
    <slot />
    <footer><SocialMediaIcons /></footer>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap&family=Oswald:wght@300");

  :root {
    --header-font: "Bebas Neue", sans-serif;
    --primary-font: "JetBrains Mono", sans-serif;
    --primary-grey: #rgb(183, 183, 188);
    --primary-white: #fff;
    /* --primary-white: #d8d8fa; */
    --primary-text-color: var(--primary-white);
    --true-periwinkle: #c3cde6;
    --my-periwinkle: #9da6bb;
  }

  header {
    display: flex;
    align-items: center;
    width: 100%;
    height: 15vh;
  }

  a {
    display: block;
    position: relative;
    left: 1rem;
    min-width: 0;
    max-width: 100%;
  }

  img {
    display: inline-block;
    width: 120px;
  }

  footer {
    /* position: fixed; */
    bottom: 0;
    width: 100%;
  }
</style>
