---
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import Logo from "../assets/images/MADELINE_LOGO_WHITE.png";
import "../styles/layout.scss";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="apple-mobile-web-app-title" content="Madeline" />
    <meta
      name="description"
      content="Artist website for Chicago-based DJ, producer, and vocalist Madeline. Listen to mixes, join the mailing list, and preview new music."
    />
    <meta property="og:title" content="Madeline: Chicago-based music artist" />
    <meta
      name="og:description"
      content="Artist website for Chicago-based DJ, producer, and vocalist Madeline. Listen to mixes, join the mailing list, and preview new music."
    />
    <meta property="og:url" content="https://madelineurl.online" />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://madelineurl.online/_astro/madeline_artist_keyboard.D3H1BMbW.jpg"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png?v=20261027"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261027" />
    <link rel="shortcut icon" href="/favicon.ico?v=20261027" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=20261027"
    />
    <link rel="manifest" href="/site.webmanifest?v=20261027" />
    <title>Madeline</title>
  </head>
  <body>
    <header>
      <a href="/">
        <span class="visually-hidden">Home</span>
        <img src={Logo.src} alt="" height="60px" width="100px" />
      </a>
    </header>
    <slot />
    <footer><SocialMediaIcons /></footer>
  </body>
</html>

<style lang="scss">
  @import url("https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap&family=Oswald:wght@300");

  header {
    position: fixed;
    display: flex;
    align-items: center;
    width: 100%;
    height: 15vh;
  }

  a {
    display: block;
    position: relative;
    left: 1rem;
    min-width: 0;
    max-width: 100%;
  }

  img {
    display: inline-block;
    width: 100px;
  }

  footer {
    position: fixed;
    bottom: 0;
    width: 100%;
  }
</style>
