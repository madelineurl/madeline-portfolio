---
import LandingPageImage from "../components/LandingPageImage.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <LandingPageImage />
  <main>
    <!-- TODO: a little gift? -->
    <div id="success" class="flex">
      <p><em>Thanks for the message</em></p>
      <div class="links">
        <a href="/">Home</a>
        <a href="/contact">Send another message</a>
      </div>
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  #success {
    font-family: var(--header-font);
    color: var(--primary-white);
    height: 100%;
    flex-direction: column;
    gap: $space-md;
  }

  p {
    font-size: 44px;
    margin: 0;
    width: 100%;
    text-align: center;
  }

  .links {
    display: flex;
    /* font-family: var(--primary-font); */

    a {
      margin: $space-xs;
      font-size: 28px;

      &:hover {
        text-decoration: underline;
      }
    }
  }
</style>
