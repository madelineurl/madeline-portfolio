---
import Layout from "../layouts/Layout.astro";
import releases from "../data/musicReleases.json";
import MusicRelease from "../components/MusicRelease.astro";

// TODO: import images once instead of in each music release
---

<Layout scrollContainer={true}>
  <main class="flex">
    <div>
      <h1 class="visually-hidden">Music releases</h1>
      <div class="release-grid">
        {
          releases.map(
            (
              {
                id,
                title,
                description,
                coverArtUrl,
                coverArtDescription,
                releaseDate,
                releasedBy,
                releaseType
              },
              listIndex
            ) => (
              <MusicRelease
                {id}
                {title}
                {description}
                {releaseDate}
                {coverArtUrl}
                {coverArtDescription}
                {listIndex}
                {releasedBy}
                releaseType={releaseType as "EP" | "Single" | "Album"}
              />
            )
          )
        }
      </div>
    </div>
  </main>
</Layout>

<!-- Could move the view transition script up here if preferred to close all other releases when the next one is expanded -->

<style lang="scss">
  @use "../styles/layout.scss" as *;

  .release-grid {
    height: 100%;
    width: 100%;
    color: var(--primary-white);
    display: grid;
    grid-template-columns: repeat(1, minmax(300px, 1fr));
    grid-auto-flow: dense;
    gap: $space-sm;
    padding: $space-sm;
  }

  @media screen and (min-width: $breakpoint-sm) {
    .release-grid {
      grid-template-columns: repeat(2, minmax(300px, 1fr));
    }

    :global(.expanded) {
      order: -1;
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: $breakpoint-md) {
    main > div {
      max-width: $breakpoint-md;
      margin: 0 auto;
    }
  }
</style>

