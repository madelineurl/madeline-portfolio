// };
// const images = import.meta.glob<{ default: ImageMetadata }>(
//   "/src/assets/images/*.{jpeg,jpg,png,gif}"
// );

// const coverArt = images[coverArtUrl];
---

<Layout>
  <main class="flex scroll-margins">
    <div>
      <h1 class="visually-hidden">Music releases</h1>
      {
        releases.map(({ title, description, coverArtUrl, releaseDate }) => (
          <MusicRelease {title} {description} {releaseDate} {coverArtUrl} />
        ))
      }
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  main > div {
    height: 100%;
    width: 100%;
    color: var(--primary-white);
    display: flex;
    flex-direction: column;
    gap: $space-xs;
    padding: $space-sm;
  }
</style>

