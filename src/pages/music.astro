---
import Layout from "../layouts/Layout.astro";
import releases from "../data/musicReleases.json";
import MusicRelease from "../components/MusicRelease.astro";
---

<Layout>
  <main>
    <div id="music" class="flex">
      <h1 class="visually-hidden">Music releases</h1>
      {
        releases.map(({ title, description, coverArtUrl }) => (
          <MusicRelease {title} {description} {coverArtUrl} />
        ))
      }
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  #music {
    height: 100%;
    color: var(--primary-white);
    display: flex;
    flex-direction: column;
  }
</style>

