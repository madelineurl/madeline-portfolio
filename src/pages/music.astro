---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <div id="music" class="flex">
      <p>
        "From the super sexy ‘fantasy daddy’, through the off-kilter ‘hurt it’,
        to slo-mo cut ‘doubtful baby’, [unlearning is] a lush and varied release
        and has us eagerly awaiting what’s next." - DJ Mag
      </p>
      <div>LISTEN</div>
      <div>BOILER ROOM CHICAGO</div>
    </div>
  </main>
</Layout>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  #music {
    height: 100%;
    color: var(--primary-white);
    flex-direction: column;
    max-width: 70vw;
    margin: 0 auto;
  }
</style>

