---
import Layout from "../layouts/Layout.astro";
import releases from "../data/musicReleases.json";
import MusicRelease from "../components/MusicRelease.astro";
// import unlearningCover from "../assets/images/unlearning_cover.jpg";
// import loveSongCover from "../assets/images/love_song_cover.jpeg";
// import clubSodaCover from "../assets/images/club_soda_cover.jpg";
// import fantasyDaddyRemixesCover from "../assets/images/fantasy_daddy_remixes_cover.png";

// const coverArts: Record<string, ImageMetadata> = {
//   "../assets/images/unlearning_cover.jpg": unlearningCover,
//   "../assets/images/love_song_cover.jpeg": loveSongCover,
//   "../assets/images/club_soda_cover.jpg": clubSodaCover,
//   "../assets/images/fantasy_daddy_remixes_cover.png": fantasyDaddyRemixesCover
//   //    "../assets/images/unlearning_cover.jpg": ""
// };
// const images = import.meta.glob<{ default: ImageMetadata }>(
//   "/src/assets/images/*.{jpeg,jpg,png,gif}"
// );

// const coverArt = images[coverArtUrl];
---

<Layout scrollContainer={true}>
  <main class="flex">
    <div>
      <h1 class="visually-hidden">Music releases</h1>
      <div class="release-grid">
        {
          releases.map(
            (
              {
                id,
                title,
                description,
                coverArtUrl,
                coverArtDescription,
                releaseDate,
                releasedBy,
                releaseType
              },
              listIndex
            ) => (
              <MusicRelease
                {id}
                {title}
                {description}
                {releaseDate}
                {coverArtUrl}
                {coverArtDescription}
                {listIndex}
                {releasedBy}
                releaseType={releaseType as "EP" | "Single" | "Album"}
              />
            )
          )
        }
      </div>
    </div>
  </main>
</Layout>

<!-- Could move the view transition script up here if preferred to close all other releases when the next one is expanded -->

<style lang="scss">
  @use "../styles/layout.scss" as *;

  .release-grid {
    height: 100%;
    width: 100%;
    color: var(--primary-white);
    display: grid;
    grid-template-columns: 400px 400px;
    grid-auto-rows: minmax(400px, auto);
    grid-auto-flow: dense;
    gap: $space-md;
    padding: $space-sm;

    :global(.expanded) {
      order: -1;
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: $breakpoint-md) {
    main > div {
      max-width: $breakpoint-md;
      margin: 0 auto;
    }
  }
</style>

