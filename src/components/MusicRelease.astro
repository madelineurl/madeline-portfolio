---
import { getImage } from "astro:assets";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  coverArtUrl: string;
  releaseType: "EP" | "Single" | "Album";
  releaseDate: string;
  listIndex: number;
  releasedBy: string;
  // coverAltDescription
}

const { title, description, coverArtUrl, releaseDate, releaseType }: Props =
  Astro.props;

const sizes = "(max-width: 990px) 400px, (max-width: 1200px) 800px, 1200px";
const importWidths = [400, 800, 1200];
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png}",
  { eager: true }
);
const matchingImage = images[coverArtUrl]?.default;

const optimizedImages = await Promise.all(
  importWidths.map((width) => getImage({ src: matchingImage, width }))
);
const srcset = optimizedImages
  .map((img) => `${img.src} ${img.attributes.width}w`)
  .join(", ");
const alt = "TODO";

function formatDate(datestring: string) {
  return new Date(datestring).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric"
  });
}
---

<music-release class="music-release">
  <div class="image-wrapper">
    <Image
      src={matchingImage}
      {sizes}
      {srcset}
      {alt}
      height="400"
      width="400"
    />
    <div class="preview flex">
      <button>{title} ({releaseType})</button>
    </div>
  </div>
  <div class="release-info">
    <span><h2>{title}</h2></span>
    <p>{description}</p>
    <span><em>{formatDate(releaseDate)}</em></span>
  </div>
</music-release>

<script>
  class MusicRelease extends HTMLElement {
    connectedCallback() {
      const titleButton = this.querySelector("button");

      titleButton?.addEventListener("click", () => {
        if (this.classList.contains("expanded")) {
          this.classList.remove("expanded");
        } else {
          this.classList.add("expanded");
        }
      });
    }
  }

  customElements.define("music-release", MusicRelease);
</script>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  .music-release {
    width: 100%;
    position: relative;
    display: grid;
    border-radius: $border-radius-sm;

    .release-info {
      display: none;
      padding: $space-sm;
      padding-top: 0;
    }

    .preview {
      display: none;
      height: 100%;
      width: 100%;
      position: absolute;
      top: 0;
      font-weight: bold;
      text-align: center;
      font-style: italic;
      font-size: 32px;
    }

    .image-wrapper {
      height: 400px;

      &:hover {
        img {
          filter: brightness(70%);
        }
        .preview {
          display: flex;
        }
      }
    }

    &.expanded {
      grid-template-columns: 400px 1fr;
      grid-template-rows: 1fr;

      .image-wrapper {
        grid-area: 1 / 1 / 2 / 1;
      }

      .release-info {
        display: flex;
      }

      img {
        filter: brightness(70%);
      }
      .preview {
        display: flex;
      }
    }
  }

  img {
    border-radius: $border-radius-sm;
    transition: filter 0.3s ease;
  }

  button {
    cursor: pointer;
    color: $white;
    padding: $space-md;
  }
</style>
