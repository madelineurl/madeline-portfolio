---
import { getImage } from "astro:assets";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  coverArtUrl: string;
  releaseDate: string;
  listIndex: number;
  // coverAltDescription
}

const { title, description, coverArtUrl, releaseDate, listIndex }: Props =
  Astro.props;

const sizes = "(max-width: 990px) 400px, (max-width: 1200px) 800px, 1200px";
const importWidths = [400, 800, 1200];
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png}",
  { eager: true }
);
const matchingImage = images[coverArtUrl]?.default;

const optimizedImages = await Promise.all(
  importWidths.map((width) => getImage({ src: matchingImage, width }))
);
const srcset = optimizedImages
  .map((img) => `${img.src} ${img.attributes.width}w`)
  .join(", ");
const alt = "TODO";

function formatDate(datestring: string) {
  return new Date(datestring).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric"
  });
}

function isEven(num: number) {
  return num % 2 === 0;
}
---

<div class="music-release" class:list={{ "left-align": isEven(listIndex) }}>
  <div class="image-wrapper">
    <Image
      src={matchingImage}
      {sizes}
      {srcset}
      {alt}
      height="400"
      width="400"
    />
  </div>
  <div class="release-info">
    <h2>{title}</h2>
    <p>{description}</p>
    <p>
      {formatDate(releaseDate)}
    </p>
  </div>
</div>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  .music-release {
    width: 100%;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 400px;
    grid-template-rows: 1fr;
    min-height: 200px;
    border-radius: $border-radius-sm;

    .image-wrapper {
      grid-area: 1 / 2 / 1 / 2;
    }

    &.left-align {
      grid-template-columns: 400px 1fr;
      grid-template-rows: 1fr;
      .image-wrapper {
        grid-area: 1 / 1 / 2 / 1;
      }
    }
  }

  img {
    border-radius: $border-radius-sm;
  }

  p {
    margin: 0;
  }

  h2 {
    margin-top: 0;
  }

  .release-info {
    padding: $space-sm;
    padding-top: 0;
  }

  @media screen and (min-width: $breakpoint-md) {
    .music-release {
      max-width: $breakpoint-md;
      margin: 0 auto;
    }
  }
</style>
