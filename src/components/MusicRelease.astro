---
import { getImage } from "astro:assets";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  coverArtUrl: string;
  releaseDate: string;
  // coverAltDescription
}

const { title, description, coverArtUrl }: Props = Astro.props;

const sizes = "(max-width: 990px) 400px, (max-width: 1200px) 600px, 200px";
const importWidths = [200, 400, 600];
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png}",
  { eager: true }
);
const matchingImage = images[coverArtUrl]?.default;

const optimizedImages = await Promise.all(
  importWidths.map((width) => getImage({ src: matchingImage, width }))
);
const srcset = optimizedImages
  .map((img) => `${img.src} ${img.attributes.width}w`)
  .join(", ");
const alt = "TODO";
console.log("IMAGE PATH:", coverArtUrl);
console.log("RESOLVED:", matchingImage);
---

<div class="music-release">
  <div class="image-wrapper">
    <Image
      src={matchingImage}
      {sizes}
      {srcset}
      {alt}
      height="200"
      width="200"
    />
  </div>
  <span><strong>{title}</strong></span>
  <p>{description}</p>
</div>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  .music-release {
    width: 100%;
    position: relative;
    display: grid;
    grid-template-columns: 200px 1fr;
    grid-template-rows: 1fr;
    min-height: 200px;
    // outline: 1px solid $white;
    border-radius: $border-radius-sm;
  }

  .image-wrapper {
    position: absolute;
    left: 0;
  }

  img {
    border-radius: $border-radius-sm;
  }

  p {
    padding: $space-sm;
    padding-top: 0;
    margin: 0;
  }

  @media screen and (min-width: $breakpoint-sm) {
    .music-release {
      max-width: $breakpoint-sm;
      margin: 0 auto;
    }
  }
</style>
