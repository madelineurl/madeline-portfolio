---
import { getImage } from "astro:assets";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: number;
  title: string;
  description: string;
  coverArtUrl: string;
  coverArtDescription: string;
  releaseType: "EP" | "Single" | "Album";
  releaseDate: string;
  listIndex: number;
  releasedBy: string;
}

const {
  id,
  title,
  description,
  coverArtUrl,
  coverArtDescription,
  releaseDate,
  releaseType,
  releasedBy
}: Props = Astro.props;

const sizes = "(max-width: 990px) 400px, (max-width: 1200px) 800px, 1200px";
const importWidths = [400, 800, 1200];
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/*.{jpeg,jpg,png}",
  { eager: true }
);
const matchingImage = images[coverArtUrl]?.default;

const optimizedImages = await Promise.all(
  importWidths.map((width) => getImage({ src: matchingImage, width }))
);
const srcset = optimizedImages
  .map((img) => `${img.src} ${img.attributes.width}w`)
  .join(", ");

function formatDate(datestring: string) {
  return new Date(datestring).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric"
  });
}
---

<music-release class="music-release" transition:name={`music-release-${id}`}>
  <div class="image-wrapper">
    <Image
      src={matchingImage}
      {sizes}
      {srcset}
      alt={coverArtDescription}
      height="400"
      width="400"
    />
    <div class="preview flex" transition:name={`preview-text-${id}`}>
      <h2><button>{title}</button></h2>
    </div>
  </div>
  <div class="release-info">
    <p>{description}</p>
    <span> {releaseType} &bull; {releasedBy}</span>
    <span><em>{formatDate(releaseDate)}</em></span>
  </div>
</music-release>

<script>
  // TODO: scrollToId
  class MusicRelease extends HTMLElement {
    connectedCallback() {
      const expandButton = this.querySelector("button");
      const preview = this.querySelector(".preview");
      const wrapper = this.querySelector(".image-wrapper");

      expandButton?.addEventListener("click", () => {
        const toggleExpand = () => {
          if (this.classList.contains("expanded")) {
            this.classList.remove("expanded");
          } else {
            this.classList.add("expanded");
            wrapper?.classList.add("active");
          }
        };

        if (!document.startViewTransition) {
          toggleExpand();
          return;
        }

        document.startViewTransition(toggleExpand);
      });

      wrapper?.addEventListener("mouseleave", () => {
        if (!this.classList.contains("expanded")) {
          wrapper?.classList.remove("active");
        }
      });
    }
  }

  customElements.define("music-release", MusicRelease);
</script>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  .music-release {
    width: 100%;
    position: relative;
    display: grid;
    gap: $space-sm;
    border-radius: $border-radius-sm;
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-columns: minmax(0, 1fr);

    .release-info {
      display: none;
      flex-direction: column;
    }

    .preview {
      opacity: 0;
      height: 100%;
      width: 100%;
      max-width: 100%;
      max-height: 100%;
      position: absolute;
      top: 0;
      font-weight: bold;
      text-align: center;
      font-style: italic;
      font-size: 28px;
      transition: opacity 0.2s ease;
    }

    .image-wrapper {
      position: relative;
      aspect-ratio: 1 / 1;

      img {
        object-fit: cover;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      &:hover,
      &.active {
        img {
          filter: brightness(50%);
        }
        .preview {
          opacity: 1;

          button:hover {
            text-decoration: underline;
          }
        }
      }
    }

    &.expanded {
      button {
        text-decoration: underline;
      }

      .release-info {
        display: flex;
      }

      img {
        filter: brightness(50%);
      }

      @media screen and (min-width: $breakpoint-sm) {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr;
      }
    }
  }

  @media screen and (min-width: $breakpoint-sm) {
    h2 {
      margin: 0;
    }

    p {
      margin-top: 0;
    }

    .release-info {
      padding: $space-sm;
      padding-top: 0;
    }

    .image-wrapper {
      grid-area: 1 / 1 / 2 / 1;
    }
  }

  img {
    border-radius: $border-radius-sm;
    transition: filter 0.3s ease;
  }

  button {
    cursor: pointer;
    color: $white;
    padding: $space-md;

    &:hover {
      text-decoration: underline;
    }
  }
</style>
