---
import Hamburger from "./icons/hamburger.svg";

const currentPath = Astro.url.pathname;

const routes = ["about", "music", "press", "dates"].map((page) => {
  const path = "/" + page;
  return { label: page, path, active: currentPath === path };
});

let mobileNavOpen = false;
---

<nav id="desktop-nav">
  <ul>
    {
      routes.map(({ label, path, active }) => (
        <li>
          <a href={path} class:list={{ active }}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<nav id="mobile-nav" class="flex" aria-expanded={mobileNavOpen}>
  <button id="toggle-mobile-nav">
    <Hamburger />
    <span class="visually-hidden">Open navigation menu</span>
  </button>
  <ul id="mobile-nav-list">
    {
      routes.map(({ label, path, active }) => (
        <li>
          <a href={path} class:list={{ active, flex: true }}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const mobileNav = document.getElementById("mobile-nav");
  const mobileNavBtn = document.getElementById("toggle-mobile-nav");
  //   const mobileNavList = document.getElementById("mobile-nav-list");

  let mobileNavOpen = false;

  mobileNavBtn?.addEventListener("click", toggleMobileNav);

  //   TODO: close nav when changing screen sizes
  function toggleMobileNav() {
    if (!mobileNavOpen) {
      mobileNavOpen = true;
      mobileNav?.classList.add("open", "true");
      mobileNav?.setAttribute("aria-expanded", "true");
    } else {
      mobileNavOpen = false;
      mobileNav?.classList.remove("open");
      mobileNav?.setAttribute("aria-expanded", "false");
    }
  }
</script>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  nav {
    font-family: Oswald;
  }

  #desktop-nav {
    display: none;

    ul {
      display: flex;
      align-items: center;
      text-align: center;
      text-transform: lowercase;
    }

    a.active {
      text-decoration: underline;
    }
  }

  #mobile-nav {
    position: fixed;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    right: 0;
    top: 0;
    min-width: 50%;

    &::after {
      content: "";
      position: sticky;
      //   bottom: 0;
      display: block;
      //   height: $headerHeight;
      background: linear-gradient(to left, $black 30%, transparent);
    }

    button {
      margin-right: $space-xs;
      margin-top: $space-xs;
      padding: $space-xs;
      cursor: pointer;
    }

    ul {
      display: none;
      flex-direction: column;
      height: 100%;
      width: 100%;
      margin-top: $space-md;
    }

    li {
      min-height: 5rem;
    }

    a {
      //   display: inline-block;
      height: 100%;

      &.active {
        background-color: $white;
        color: $black;
      }
    }

    &.open {
      height: 100%;
      z-index: 9;
      background-color: black;

      ul {
        display: flex;
      }
    }
  }

  ul {
    list-style-type: none;
    margin-block-start: 0;
    margin-block-end: 0;
    padding-inline-start: 0;
  }

  a {
    height: auto;
    font-weight: 600;
    width: 100%;
    color: var(--primary-white);
    font-size: 2.5rem;
    padding: $space-xs $space-md;
    transition: color 2s linear;

    &:hover {
      color: rgb(212, 224, 255);
      outline: 1px solid $white;
      border-radius: $border-radius-sm;
    }
  }

  @media screen and (min-width: $breakpoint-xs) {
    #mobile-nav {
      min-width: 30%;
    }
  }

  @media screen and (min-width: $breakpoint-sm) {
    #mobile-nav {
      display: none;
    }

    #desktop-nav {
      display: flex;
      position: relative;
      flex-direction: row;
      justify-content: flex-end;
      height: 100%;
      width: 100%;
      a {
        font-size: 20px;
        margin-right: $space-lg;
        width: auto;
      }
    }
  }
</style>
