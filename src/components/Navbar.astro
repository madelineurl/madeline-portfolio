---
const currentPath = Astro.url.pathname;

const routes = ["about", "music", "press", "upcoming"].map((page) => {
  const path = "/" + page;
  return { label: page, path, active: currentPath === path };
});
---

<nav>
  {
    routes.map(({ label, path, active }) => (
      <a href={path} class:list={{ active }}>
        {label}
      </a>
    ))
  }
</nav>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  nav {
    // position: fixed;
    font-family: Oswald;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-transform: lowercase;
    display: none;

    &.open {
      display: flex;
    }
  }

  nav.hide {
    transform: translateX(150%);
    opacity: 1;
  }

  a {
    height: auto;
    font-weight: 600;
    // width: 100%;
    color: var(--primary-white);
    font-size: 2.5rem;
    padding: $space-xs $space-md;

    &.active {
      text-decoration: underline;
    }

    &:hover {
      background-color: rgba(65, 73, 94, 0.8);
    }
  }

  @media screen and (min-width: $breakpoint-sm) {
    nav {
      display: flex;
      position: relative;
      flex-direction: row;
      justify-content: flex-end;
      height: 100%;
      width: 100%;
    }

    a {
      font-size: 20px;
      margin-right: $space-lg;
    }
  }
</style>
