---
import Contact from "./icons/mail-backup.svg";
import Bandcamp from "./icons/bandcamp.svg";
import Soundcloud from "./icons/soundcloud.svg";
import ResidentAdvisor from "./icons/ra.svg";
import Spotify from "./icons/spotify.svg";
import Instagram from "./icons/instagram.svg";
import { ExternalLink } from "./";
---

<div class="icons-container">
  <a href="/contact" class="flex">
    <span class="visually-hidden">Contact me</span>
    <Contact class="icon enlarge" />
  </a>
  <ExternalLink
    label="Spotify artist page"
    url="https://open.spotify.com/artist/2eMwoPf6uvrCLcKEmrfmel"
  >
    <Spotify class="icon enlarge" />
  </ExternalLink>
  <ExternalLink
    label="Bandcamp artist page"
    url="https://madelineurl.bandcamp.com/releases"
  >
    <Bandcamp class="icon enlarge" />
  </ExternalLink>
  <ExternalLink label="Soundcloud" url="https://soundcloud.com/madeline-url">
    <Soundcloud class="icon enlarge" />
  </ExternalLink>
  <ExternalLink
    label="Resident Advisor artist page"
    url="https://ra.co/dj/madelinechi"
  >
    <ResidentAdvisor class="icon enlarge" />
  </ExternalLink>
  <ExternalLink label="Instagram" url="https://www.instagram.com/soft.content">
    <Instagram class="icon enlarge" />
  </ExternalLink>
</div>

<style lang="scss">
  @use "../styles/layout.scss" as *;
  .icons-container {
    margin-bottom: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .icon {
    width: 48px;
    height: 48px;
    margin: 0.35rem;
    margin-bottom: 0;
    transition: transform 0.2s ease-in-out;
  }

  @media screen and (min-width: $breakpoint-sm) {
    .icons-container {
      margin-bottom: 0.75rem;
    }
  }

  @media screen and (min-width: $breakpoint-md) {
    .icon {
      width: 44px;
      height: 44px;
    }
  }
</style>
