---
import ClientRouter from "astro/components/ClientRouter.astro";
---

<ClientRouter />

<form
  name="contact"
  method="POST"
  action="https://api.web3forms.com/submit"
  class="form"
>
  <div class="warning">Please fill out all fields</div>
  <input
    type="hidden"
    name="access_key"
    value="d7588354-23fd-49fd-b11b-dd74e5497fd8"
  />
  <input
    type="hidden"
    name="redirect"
    value="https://madelineurl.online/success"
  />
  <input type="text" name="name" id="name" placeholder="name" required />
  <label for="name" class="visually-hidden">Name</label>
  <input type="email" name="email" id="email" placeholder="email" required />
  <label for="email" class="visually-hidden">Email</label>
  <textarea name="message" id="message" placeholder="message" required>
  </textarea>
  <label for="message" class="visually-hidden">Message</label>

  <div>
    <button type="submit" id="submit-btn" class="btn enlarge flex">
      Send
    </button>
  </div>
</form>

<script>
  const name = document.getElementById("name") as HTMLInputElement;
  const email = document.getElementById("email") as HTMLInputElement;
  const message = document.getElementById("message") as HTMLInputElement;
  const send = document.getElementById("submit-btn") as HTMLButtonElement;

  [name, email, message].forEach((input) => {
    input?.addEventListener("change", (event) => {
      if (!event.target?.value) {
        send.disabled = true;
      } else {
        send.disabled = false;
      }
    });
  });
</script>

<style>
  #contact {
    position: relative;
    height: 100vh;
  }

  .form {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--primary-font);
    position: relative;
    /* animation: slide-in-top 0.5s ease; */
    width: 100%;
    padding: 0 0.5rem;
    position: relative;
    top: 10vh;
  }

  .form textarea {
    height: 25vh;
  }

  .form input,
  .form textarea {
    border: 2px solid rgba(209, 209, 209, 0.5);
    padding: 0.5rem 0.7rem;
    background-color: var(--primary-white);
    border-radius: 5px;
    margin-bottom: 0.5rem;
    font-family: var(--header-font);
  }

  .form input:focus,
  .form textarea:focus {
    outline: 0;
  }

  .warning {
    color: rgb(243 51 51);
    margin-bottom: 2vh;
    font-size: 1.2rem;
    opacity: 0;
    transition: opacity 0.3s linear;
    font-family: var(--header-font);
  }

  .warning.show {
    opacity: 1;
  }

  label {
    display: inline;
  }
</style>
