---
import artistPhoto from "../assets/images/madeline_artist_keyboard.jpg";
---

<img id="background" src={artistPhoto.src} alt="" fetchpriority="high" />
<main class="main">
  <p>
    Madeline is a Chicago-based artist and engineer exploring the sensual
    corners of electronic music.
  </p>
</main>

<style>
  main {
    box-sizing: border-box;
    font-family: var(--primary-font);
    overscroll-behavior: none;
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
    display: flex;
    flex-direction: column;
    font-family: var(--header-font);
    color: #fff;
    font-size: 24px;
    height: 100%;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    width: auto;
    max-width: 60%;
    margin: 0 auto;

    p {
      position: relative;
      top: 30%;
      margin-left: 1rem;
      margin-right: 2rem;
      background-color: black;
      padding: 1rem;
      border-radius: 8px;
    }
  }

  #background {
    background-size: cover;
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    z-index: -1;
    filter: blur(20px);
    transition: filter 0.4s ease-in;
  }
  @media screen and (min-width: 992px) {
    #background {
      filter: blur(0px);
    }

    main {
      width: auto;
      max-width: 40%;
      margin-left: 2rem;
    }
  }
</style>
