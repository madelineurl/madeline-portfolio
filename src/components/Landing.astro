---
import artistPhoto from "../assets/images/madeline_artist_keyboard.jpg";
---

<img id="background" src={artistPhoto.src} alt="" fetchpriority="high" />
<main class="main">
  <p>
    Madeline is a Chicago-based artist and engineer exploring the sensual
    corners of electronic music.
  </p>
</main>

<!-- test commit -->

<style>
  main {
    box-sizing: border-box;
    font-family: var(--primary-font);
    overscroll-behavior: none;
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
    display: flex;
    flex-direction: column;
    font-family: var(--header-font);
    max-width: 40%;
    margin-left: 2rem;
    color: #fff;
    font-size: 24px;
    height: 100%;
    flex: 1;
    min-height: 0;
    overflow-y: auto;

    p {
      position: relative;
      top: 30%;
      padding-left: 1rem;
      padding-right: 2rem;
    }
  }

  #background {
    background-size: cover;
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    z-index: -1;
    /* filter: blur(100px); */
  }

