---
import LandingPageImage from "./LandingPageImage.astro";
---

<div class="split-screen-container">
  <main class="flex">
    <div>
      <h1>Madeline</h1>
      <p>
        is a Chicago-based artist exploring the sensual corners of electronic
        music.
        <!-- TODO: add latest release feature; Will become an <a> tag eventually -->
        <!-- <span class="cta flex">Latest release <Caret class="global-enlarge icon" /></span> -->
      </p>
    </div>
  </main>
  <LandingPageImage progressiveBlur={true} />
</div>

<style lang="scss">
  @use "../styles/layout.scss" as *;

  main {
    grid-column: 1;
    font-family: var(--primary-font);
    overscroll-behavior: none;
    flex-direction: column;
    font-family: var(--header-font);
    color: var(--primary-white);
    font-size: 24px;
    overflow-y: auto;
    margin: 0 auto;
    padding: 2.5rem;
    min-height: 100%;
    width: 100%;

    p {
      display: inline;
      margin: 0;
      font-size: 52px;
      line-height: 1.1;
    }

    span {
      width: 100%;
    }
  }

  h1 {
    display: inline-block;
    font-size: 52px;
    margin-right: $space-xs;
    font-weight: 500;
  }

  .icon {
    height: 24px;
    width: 24px;
  }

  @media screen and (min-width: $breakpoint-xs) {
    main {
      text-align: center;
    }

    .cta {
      justify-content: center;
    }
  }

  @media screen and (min-width: $breakpoint-sm) {
    main {
      p,
      h1 {
        font-size: 48px;
      }
    }

    .cta {
      justify-content: flex-start;
    }
  }

  @media screen and (min-width: $breakpoint-md) {
    main {
      max-width: 70%;
      padding: 0;

      p,
      h1 {
        font-size: 44px;
      }
    }
  }
</style>
