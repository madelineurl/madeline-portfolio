---
import artistPhoto from "../assets/images/madeline_artist_2026.jpg";
---

<!-- <img id="background" src={artistPhoto.src} alt="" fetchpriority="high" /> -->
<main class="main">
  <h1 id="madeline">madeline</h1>
</main>

<style>
  main {
    box-sizing: border-box;
    font-family: var(--primary-font);
    overscroll-behavior: none;
    /* height: 100vh; */
    /* background: url('https://ik.imagekit.io/vpvecpntw/artist-photo.jpg'); */
    /* background-size: cover; */
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
    /* padding-top: 5rem; */
    overflow: hidden;
    height: 100%;
    display: flex;
    justify-content: center;
    font-family: var(--header-font);
    /* left: 25vw; */
    /* position: absolute; */
    /* top: 40v h; */
  }

  #background {
    background-size: cover;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    /* filter: blur(100px); */
  }

  #madeline {
    color: var(--primary-text-color);
    font-family: var(--header-font);
    font-size: 3.5rem;
    font-weight: 400;
    margin-bottom: 0;
    padding: 0.5rem 0.9rem;
  }
</style>
