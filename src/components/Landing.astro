---
import artistPhoto from "../assets/images/madeline_artist_keyboard.jpg";
---

<img id="background" src={artistPhoto.src} alt="" fetchpriority="high" />
<main class="main">
  <p>
    Madeline is a Chicago-based artist exploring the sensual corners of
    electronic music.
  </p>
</main>

<style>
  main {
    font-family: var(--primary-font);
    overscroll-behavior: none;
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
      env(safe-area-inset-bottom) env(safe-area-inset-left);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--header-font);
    color: #fff;
    font-size: 24px;
    flex: 1;
    overflow-y: auto;

    max-width: 70%;
    margin: 0 auto;
    /* transition: margin-left 3s ease-in-out;
    transition: max-width 3s linear; */

    p {
      margin: 0;
      font-size: 52px;
      position: relative;
      line-height: 1.1;
    }
  }

  #background {
    background-size: cover;
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    z-index: -1;
    filter: blur(30px);
    transition: filter 0.4s ease-in;
  }
  @media screen and (min-width: 500px) {
    #background {
      filter: blur(20px);
    }

    p {
      font-size: 48px;
    }
  }

  @media screen and (min-width: 768px) {
    #background {
      filter: blur(10px);
    }

    main {
      width: auto;
      max-width: 40%;
      margin-left: 2rem;

      p {
        font-size: 44px;
      }
    }
  }

  @media screen and (min-width: 992px) {
    #background {
      filter: blur(0px);
    }

    main p {
      font-size: 36px;
      text-align: center;
    }
  }
</style>
