---
import artistPhoto from "../assets/images/madeline_artist_keyboard.jpg";
import { getImage } from "astro:assets";

const { src } = artistPhoto;
// above the 1100px breakpoint, the image resizes to fit 50% of the viewport width
// below the 1100px breakpoint, the image is fixed at 600px (needs 600, 1200, 1800)
// below 600px, the image resizes to fit the viewport width
// image is increasingly blurred below 990px breakpoint, so the quality doesn't matter - tell the browser to fetch a lower width image than the actual image width
// largest size accounts for a 2400px screen where the image width is 1200px, largest size needed is 3600 to account for 3:1 DPRs
const sizes =
  "(max-width: 990px) 400px, (max-width: 1200px) 600px, (max-width: 1600px) 800px, 1200px";
const importWidths = [400, 600, 800, 1200, 1400, 1600, 1800, 2400, 3600];
const optimizedImages = await Promise.all(
  importWidths.map((width) => getImage({ src: artistPhoto, width }))
);
const srcset = optimizedImages
  .map((img) => `${img.src} ${img.attributes.width}w`)
  .join(", ");
const alt =
  "Madeline holds a digital keyboard vertically at an angle and rests their cheek against it, wearing a white ribbed tank in a woodshop surrounded by moving boxes";
---

<div class="split-screen-container">
  <main class="flex">
    <p class="flex">
      Madeline is a Chicago-based artist exploring the sensual corners of
      electronic music.
      <!-- TODO: add latest release feature; Will become an <a> tag eventually -->
      <!-- <span class="cta flex">Latest release <Caret class="global-enlarge icon" /></span> -->
    </p>
  </main>
  <div class="image-wrapper blur">
    <img
      id="background"
      class="half-screen-image"
      fetchpriority="high"
      {alt}
      {sizes}
      {src}
      {srcset}
    />
  </div>

  <style lang="scss">
    @use "../styles/layout.scss" as *;

    .split-screen-container {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .image-wrapper {
      grid-column: 2;
      width: auto;
      height: 100vh; // fallback to standard viewheight
      height: 100dvh; // use dynamic viewport height when available (i.e. mobile)
      overflow: hidden;
    }

    main {
      grid-column: 1;
      font-family: var(--primary-font);
      overscroll-behavior: none;
      flex-direction: column;
      font-family: var(--header-font);
      color: var(--primary-white);
      font-size: 24px;
      overflow-y: auto;
      margin: 0 auto;
      padding: 2.5rem;
      min-height: 100%;
      width: 100%;

      p {
        margin: 0;
        font-size: 52px;
        line-height: 1.1;
        flex-direction: column;
        justify-content: flex-start;
        gap: 1rem;
      }

      span {
        width: 100%;
      }
    }

    // .cta {
    //   justify-content: flex-start;
    //   gap: 0.5rem;
    //   font-size: 20px;
    //   font-weight: normal;
    // }

    .icon {
      height: 24px;
      width: 24px;
    }

    @media screen and (min-width: $breakpoint-xs) {
      main {
        text-align: center;
      }

      .cta {
        justify-content: center;
      }

      .image-wrapper {
        filter: blur(20px);
      }
    }

    @media screen and (min-width: $breakpoint-sm) {
      .split-screen-container {
        grid-template-columns: 1fr 1fr;
      }

      main {
        text-align: left;
        p {
          font-size: 48px;
        }
      }

      .cta {
        justify-content: flex-start;
      }

      .image-wrapper {
        filter: blur(10px);
      }
    }

    @media screen and (min-width: $breakpoint-md) {
      .image-wrapper {
        filter: blur(0px);
      }

      main {
        max-width: 70%;
        padding: 0;

        p {
          font-size: 44px;
        }
      }
    }

    @media screen and (min-width: $breakpoint-lg) {
      .image-wrapper {
        width: 50vw;
      }
    }
  </style>
</div>
