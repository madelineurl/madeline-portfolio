---
import LandingPageImage from "./LandingPageImage.astro";
---

<div class="split-screen-container">
  <main class="flex">
    <p class="flex">
      Madeline is a Chicago-based artist exploring the sensual corners of
      electronic music.
      <!-- TODO: add latest release feature; Will become an <a> tag eventually -->
      <!-- <span class="cta flex">Latest release <Caret class="global-enlarge icon" /></span> -->
    </p>
  </main>
  <LandingPageImage progressiveBlur={true} />

  <style lang="scss">
    @use "../styles/layout.scss" as *;

    .split-screen-container {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    main {
      grid-column: 1;
      font-family: var(--primary-font);
      overscroll-behavior: none;
      flex-direction: column;
      font-family: var(--header-font);
      color: var(--primary-white);
      font-size: 24px;
      overflow-y: auto;
      margin: 0 auto;
      padding: 2.5rem;
      min-height: 100%;
      width: 100%;

      p {
        margin: 0;
        font-size: 52px;
        line-height: 1.1;
        flex-direction: column;
        justify-content: flex-start;
        gap: $space-sm;
      }

      span {
        width: 100%;
      }
    }

    // .cta {
    //   justify-content: flex-start;
    //   gap: $space-xs;
    //   font-size: 20px;
    //   font-weight: normal;
    // }

    .icon {
      height: 24px;
      width: 24px;
    }

    @media screen and (min-width: $breakpoint-xs) {
      main {
        text-align: center;
      }

      .cta {
        justify-content: center;
      }
    }

    @media screen and (min-width: $breakpoint-sm) {
      .split-screen-container {
        grid-template-columns: 1fr 1fr;
      }

      main {
        text-align: left;
        p {
          font-size: 48px;
        }
      }

      .cta {
        justify-content: flex-start;
      }
    }

    @media screen and (min-width: $breakpoint-md) {
      main {
        max-width: 70%;
        padding: 0;

        p {
          font-size: 44px;
        }
      }
    }
  </style>
</div>
