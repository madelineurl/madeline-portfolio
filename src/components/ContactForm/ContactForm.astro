---
import ClientRouter from "astro/components/ClientRouter.astro";
import artistPhoto from "../../assets/images/madeline_artist_keyboard.jpg";
---

<ClientRouter />

<img id="background" src={artistPhoto.src} />
<main>
  <form
    name="contact"
    id="contact-form"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    action="/success"
  >
    <div id="warning"></div>
    <input type="hidden" name="form-name" value="contact" />
    <input type="hidden" name="bot-field" />
    <input type="text" name="name" id="name" placeholder="name" required />
    <label for="name" class="visually-hidden">Name</label>
    <input type="email" name="email" id="email" placeholder="email" required />
    <label for="email" class="visually-hidden">Email</label>
    <textarea name="message" id="message" placeholder="message" required
    ></textarea>
    <label for="message" class="visually-hidden">Message</label>
    <button type="submit" id="submit" disabled> Send </button>
  </form>
</main>

<script>
  import {
    type FormFields,
    updateDisabledState,
    updateInputValidity,
    updateWarningVisibility,
    writeValue
  } from "./contact-form";

  // TODO: extract and refactor to use functional programming techniques
  const nameInput = document.getElementById("name") as HTMLInputElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const messageInput = document.getElementById(
    "message"
  ) as HTMLTextAreaElement;
  const warning = document.getElementById("warning") as HTMLButtonElement;
  const sendBtn = document.getElementById("submit") as HTMLButtonElement;
  let formFields: FormFields = {
    name: null,
    email: null,
    message: null
  };

  [nameInput, emailInput, messageInput].forEach((input) =>
    input?.addEventListener("keyup", (event) => {
      if (
        event.target instanceof HTMLInputElement ||
        event.target instanceof HTMLTextAreaElement
      ) {
        const { name, value } = event.target;
        formFields = writeValue(formFields, name, value);

        // can we move these to react to changes in form fields instead?
        updateInputValidity(event.target, value);
        updateWarningVisibility(formFields, warning);
        updateDisabledState(formFields, sendBtn);
      }
    })
  );
</script>

<style lang="scss">
  @use "../../styles/layout.scss" as *;

  img#background {
    background-size: cover;
    object-fit: cover;
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    z-index: -1;
    filter: blur(20px);
    /* transition: filter 0.4s ease-in; */
  }
  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    width: 100%;
    padding: 0 0.75rem;
    /* height: 100%; */
    font-size: 1.2rem;
    top: 20vh;
  }

  form textarea {
    height: 25vh;
  }

  form input,
  form textarea {
    border: 2px solid rgba(209, 209, 209, 0.5);
    padding: 0.5rem 0.7rem;
    background-color: var(--primary-white);
    border-radius: 5px;
    margin-bottom: 0.5rem;
    font-family: var(--header-font);
    width: 100%;
  }

  form input:focus,
  form textarea:focus {
    outline: 0;
  }

  button[type="submit"] {
    margin-top: 1rem;
    font-family: var(--header-font);
    background-color: var(--primary-white);
    border: none;
    font-size: 1.2rem;
    &:hover:not(:disabled) {
      background-color: rgb(186, 186, 186);
      cursor: pointer;
    }
  }

  #warning {
    position: absolute;
    top: -2rem;
    visibility: hidden;
    color: rgb(243 51 51);
    margin-bottom: 2vh;
    font-size: 1.2rem;
    transition: opacity 0.3s linear;
    font-family: var(--header-font);
  }

  #warning.show {
    visibility: visible;
  }

  @media screen and (min-width: $breakpoint-xs) {
    form {
      width: $breakpoint-xs;
      margin: 0 auto;
    }
  }
</style>
